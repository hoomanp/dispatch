{
  "title": "DISPATCH Observability",
  "uid": "dispatch-main",
  "timezone": "browser",
  "refresh": "10s",
  "panels": [
    {"id":1,"type":"timeseries","title":"Requests/min by tier",
     "gridPos":{"x":0,"y":0,"w":12,"h":8},
     "targets":[{"expr":"sum by (tier) (rate(dispatch_requests_total[5m])) * 60"}]},
    {"id":2,"type":"timeseries","title":"p50 / p95 latency by model group",
     "gridPos":{"x":12,"y":0,"w":12,"h":8},
     "targets":[
       {"expr":"histogram_quantile(0.5, sum by (le, model_group) (rate(dispatch_request_seconds_bucket[5m])))","legendFormat":"p50 {{model_group}}"},
       {"expr":"histogram_quantile(0.95, sum by (le, model_group) (rate(dispatch_request_seconds_bucket[5m])))","legendFormat":"p95 {{model_group}}"}]},
    {"id":3,"type":"gauge","title":"Monthly spend vs budget",
     "gridPos":{"x":0,"y":8,"w":6,"h":6},
     "targets":[{"expr":"dispatch_monthly_spend_usd / dispatch_monthly_budget_usd * 100"}],
     "fieldConfig":{"defaults":{"unit":"percent","max":100,
       "thresholds":{"steps":[{"color":"green","value":0},{"color":"yellow","value":60},{"color":"red","value":85}]}}}},
    {"id":4,"type":"timeseries","title":"Tokens/min by direction",
     "gridPos":{"x":6,"y":8,"w":9,"h":6},
     "targets":[{"expr":"sum by (direction) (rate(dispatch_tokens_total[5m])) * 60"}]},
    {"id":5,"type":"stat","title":"Boundary denials (1h)",
     "gridPos":{"x":15,"y":8,"w":4,"h":6},
     "targets":[{"expr":"sum(increase(dispatch_boundary_denials_total[1h]))"}]},
    {"id":6,"type":"stat","title":"Memory: facts / sessions",
     "gridPos":{"x":19,"y":8,"w":5,"h":6},
     "targets":[{"expr":"dispatch_memory_facts","legendFormat":"facts"},
                {"expr":"dispatch_memory_sessions","legendFormat":"sessions"}]},
    {"id":7,"type":"timeseries","title":"Requests by model group",
     "gridPos":{"x":0,"y":14,"w":12,"h":8},
     "targets":[{"expr":"sum by (model_group) (rate(dispatch_requests_total{outcome=\"ok\"}[5m])) * 60"}]},
    {"id":8,"type":"timeseries","title":"Denied vs OK outcomes",
     "gridPos":{"x":12,"y":14,"w":12,"h":8},
     "targets":[{"expr":"sum by (outcome) (rate(dispatch_requests_total[5m])) * 60"}]}
  ],
  "schemaVersion": 39
}
