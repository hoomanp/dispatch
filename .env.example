# All keys optional — add what you have. DISPATCH routes around missing tiers.

# Tier 1 — free (worth getting; they cost nothing)
GROQ_API_KEY=            # console.groq.com
OPENROUTER_API_KEY=      # openrouter.ai
GOOGLE_API_KEY=          # aistudio.google.com

# Tier 2 — budget
DEEPSEEK_API_KEY=        # platform.deepseek.com
KIMI_API_KEY=            # platform.moonshot.cn

# Tier 3 — premium
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# DISPATCH settings
LITELLM_MASTER_KEY=sk-dispatch-master   # change this
MONTHLY_BUDGET_USD=50
DAILY_SOFT_LIMIT_USD=5

# Local Ollama node (for memory engine + embeddings)
# Use host.docker.internal:11434 if Ollama runs on the docker host,
# or the LAN/Tailscale IP of your always-on box.
OLLAMA_URL=http://host.docker.internal:11434

# ── Security & tracing ──────────────────────────────────────────
# Set to require Bearer/x-api-key auth on port 8080 (recommended
# before exposing beyond localhost). /health and /metrics stay open.
DISPATCH_API_KEY=

# Set to enable distributed tracing (dispatcher -> LiteLLM -> provider).
# With the observability profile running: http://jaeger:4318/v1/traces
OTEL_EXPORTER_OTLP_ENDPOINT=
